# Salin menjadi .env lalu isi nilai acak, atau jalankan: npm run setup
JWT_SECRET=ganti-dengan-string-acak-panjang
GATEWAY_SECRET=ganti-dengan-string-acak-panjang
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-string-acak-panjang

# Jam akses perubahan/finalisasi nilai: START <= jam < END (zona waktu ACCESS_TZ)
ACCESS_HOUR_START=7
ACCESS_HOUR_END=21
ACCESS_TZ=Asia/Jakarta
